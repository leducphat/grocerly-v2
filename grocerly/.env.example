# Environment variables read by the application.
# Copy this file to .env and fill in the values. Never commit .env.
#
# KLTN runs on its own host, database and image storage (docs/DECISIONS.md
# D-002, D-034). Check that these values name the KLTN resources before any
# migrate or deploy.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 1 turns debug mode on, and it is the default when the key is missing.
# The deployed site must set 0.
DJANGO_DEBUG=0
# Comma-separated, no spaces.
DJANGO_ALLOWED_HOSTS=your-service.onrender.com

# PostgreSQL connection. Without it Django falls back to a local SQLite file.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://grocerly:change-me-to-a-strong-password@your-database-host:5432/grocerly

# Uploaded images. With USE_CLOUDINARY=False they are written to media/ instead.
USE_CLOUDINARY=True
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Google Gemini, used by the AI assistant
GEMINI_API_KEY=your_gemini_api_key_here

# VNPay. The two URLs below are the sandbox endpoints.
VNPAY_TMN_CODE=your_terminal_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
